<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <modules>
        <module>assemblies</module>
        <module>impl</module>
        <module>ui</module>
    </modules>

    <properties>
        <!-- 原值 4.6 仅存在于 Pentaho 私有仓库；中央仓库只有 4.3。
             SWT 为 provided 作用域，仅用于编译，运行期使用 Kettle 自带的 SWT，故降为 4.3 不影响功能。 -->
        <org.eclipse.swt.version>4.3</org.eclipse.swt.version>
        <jface.version>3.3.0-I20070606-0010</jface.version>
        <!-- 原值 9.5.0.0-240（上游默认）。改为 8.3.0.0-371 以匹配公司机器实际安装的 Kettle，
             否则会报 Could not find artifact pentaho-kettle:pdi-kettle-all:pom:9.5.0.0-240 -->
        <pdi.version>8.3.0.0-371</pdi.version>
    </properties>

    <parent>
        <groupId>org.pentaho.di.plugins</groupId>
        <artifactId>pdi-plugins</artifactId>
        <version>8.3.0.0-371</version>
    </parent>

    <artifactId>starrocks-kettle-connector</artifactId>
    <groupId>com.starrocks</groupId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PDI StarRocks Kettle Connector Plugin</name>
    <description>This plugin is for pentaho Data integration (ETL) a.k.a kettle</description>
    <url>http://www.pentaho.com/</url>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pentaho-kettle</groupId>
                <artifactId>kettle-engine</artifactId>
                <version>${pdi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>pentaho-kettle</groupId>
                <artifactId>kettle-core</artifactId>
                <version>${pdi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>pentaho-kettle</groupId>
                <artifactId>kettle-ui-swt</artifactId>
                <version>${pdi.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- StarRocks Stream Load SDK -->
            <dependency>
                <groupId>com.starrocks</groupId>
                <artifactId>starrocks-stream-load-sdk</artifactId>
                <!-- 原值 1.0-SNAPSHOT 从未发布到任何公共仓库；中央仓库只有 1.0（含 jar-with-dependencies 分类器） -->
                <version>1.0</version>
                <classifier>jar-with-dependencies</classifier>
            </dependency>


            <!-- SWT is required to compile,inorder to work with architecture -->
            <dependency>
                <groupId>org.eclipse.swt</groupId>
                <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
                <version>${org.eclipse.swt.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <artifactId>*</artifactId>
                        <groupId>*</groupId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse</groupId>
                <artifactId>jface</artifactId>
                <version>${jface.version}</version>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <artifactId>*</artifactId>
                        <groupId>*</groupId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>0.15</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <excludeSubProjects>false</excludeSubProjects>
                    <numUnapprovedLicenses>0</numUnapprovedLicenses>
                    <licenses>
                        <license implementation="org.apache.rat.analysis.license.SimplePatternBasedLicense">
                            <licenseFamilyCategory>AL2</licenseFamilyCategory>
                            <licenseFamilyName>Apache License 2.0</licenseFamilyName>
                            <notes/>
                            <patterns>
                                <pattern>Licensed to the Apache Software Foundation (ASF) under one</pattern>
                            </patterns>
                        </license>
                    </licenses>
                    <licenseFamilies>
                        <licenseFamily implementation="org.apache.rat.license.SimpleLicenseFamily">
                            <familyName>Apache License 2.0</familyName>
                        </licenseFamily>
                    </licenseFamilies>
                    <excludes>
                        <exclude>**/image/**</exclude>
                        <exclude>README.md</exclude>
                        <exclude>.github/**</exclude>
                        <exclude>**/resources/**</exclude>
                        <!-- 必须用 **/target/** 才能同时排除子模块的 target。
                             原来的 target/** 只锚定根目录，impl/target、ui/target 里的
                             构建产物会被当成"无许可证头"的文件，导致 RAT 检查失败。 -->
                        <exclude>**/target/**</exclude>
                        <exclude>**/logs/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
      【离线改造】原来的 pentaho-public / pentaho-public-plugins 两个仓库已在此移除。
      原因：旧地址 repo.orl.eng.hitachivantara.com 已下线，新地址 repo.pentaho.com
      所有仓库路径均返回 401 需要登录，无法匿名使用。
      替代方案：用 kettle-offline/PdiOfflineSetup.java 把本机 Kettle 的 lib 目录
      灌入 Maven 本地仓库，项目通过 pentaho-kettle:pdi-kettle-all 聚合依赖引用。
      如果将来拿到了可用凭据，把下面这段恢复即可：

        <repositories>
            <repository>
                <id>pentaho-public</id>
                <name>Pentaho Public</name>
                <url>https://repo.pentaho.com/artifactory/pnt-mvn/</url>
            </repository>
        </repositories>
        <pluginRepositories>
            <pluginRepository>
                <id>pentaho-public-plugins</id>
                <name>Pentaho Public Plugins</name>
                <url>https://repo.pentaho.com/artifactory/pnt-mvn/</url>
            </pluginRepository>
        </pluginRepositories>
    -->
</project>